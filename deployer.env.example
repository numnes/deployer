# Public URLs for the deployer dashboard / API behind nginx (or a reverse proxy).
# Copy to deployer.env and edit — this file is NOT overwritten by `deployer restart`.
#
#   cp deployer.env.example deployer.env
#
# Leave unset (or omit this file) for local-only defaults:
#   CORS → http://localhost:<web-port>
#   Web build → NEXT_PUBLIC_API_URL=http://localhost:<api-port>

# Browser Origin of the dashboard (written to api/.env as CORS_ORIGIN)
DEPLOYER_PUBLIC_WEB_URL=https://deployer.example.com

# Public API URL baked into the web image (NEXT_PUBLIC_API_URL)
# Use a path if the API is mounted under nginx, e.g. https://host/api
DEPLOYER_PUBLIC_API_URL=https://deployer.example.com/api

# Optional: Next.js basePath when the UI is not at the site root (e.g. /deployer)
# DEPLOYER_PUBLIC_WEB_BASE_PATH=/deployer

# Optional: pin host ports so `deployer restart` does not reassign them (nginx stays valid).
# If set and the port is busy, setup fails instead of picking another port.
# DEPLOYER_API_PORT=3002
# DEPLOYER_WEB_PORT=3001
# DEPLOYER_POSTGRES_PORT=5432
# DEPLOYER_REDIS_PORT=6480

# Optional: version label in the dashboard sidebar (defaults to `git describe --tags`)
# DEPLOYER_VERSION=v0.2.10
